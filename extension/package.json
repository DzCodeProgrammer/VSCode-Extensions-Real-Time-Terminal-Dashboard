{
  "name": "real-time-terminal-dashboard",
  "displayName": "Real-Time Terminal Dashboard",
  "description": "Realtime cyberpunk system, terminal, process, and Git telemetry for VSCode.",
  "version": "0.1.0",
  "publisher": "DzCodeProgrammer",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/DzCodeProgrammer/VSCode-Extensions-Real-Time-Terminal-Dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/DzCodeProgrammer/VSCode-Extensions-Real-Time-Terminal-Dashboard/issues"
  },
  "homepage": "https://github.com/DzCodeProgrammer/VSCode-Extensions-Real-Time-Terminal-Dashboard#readme",
  "keywords": [
    "vscode",
    "terminal",
    "dashboard",
    "monitoring",
    "fastapi",
    "websocket",
    "htmx",
    "devops"
  ],
  "galleryBanner": {
    "color": "#06070d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCommand:realtimeTerminalDashboard.open",
    "onCommand:realtimeTerminalDashboard.startBackend",
    "onCommand:realtimeTerminalDashboard.stopBackend",
    "onCommand:realtimeTerminalDashboard.installBackendDependencies",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "realtimeTerminalDashboard.open",
        "title": "Real-Time Terminal Dashboard: Open Dashboard"
      },
      {
        "command": "realtimeTerminalDashboard.startBackend",
        "title": "Real-Time Terminal Dashboard: Start Backend"
      },
      {
        "command": "realtimeTerminalDashboard.stopBackend",
        "title": "Real-Time Terminal Dashboard: Stop Backend"
      },
      {
        "command": "realtimeTerminalDashboard.installBackendDependencies",
        "title": "Real-Time Terminal Dashboard: Install Backend Dependencies"
      }
    ],
    "configuration": {
      "title": "Real-Time Terminal Dashboard",
      "properties": {
        "realtimeTerminalDashboard.backendPort": {
          "type": "number",
          "default": 8765,
          "description": "Local FastAPI backend port."
        },
        "realtimeTerminalDashboard.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used to launch the backend."
        }
      }
    }
  },
  "scripts": {
    "start": "npm.cmd run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "sync-backend": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/sync-backend.ps1",
    "package": "npm.cmd run sync-backend && npm.cmd run compile && vsce package --out real-time-terminal-dashboard.vsix",
    "publish": "npm.cmd run sync-backend && npm.cmd run compile && vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.4.5"
  }
}